{
  "name": "adora-alora",
  "version": "1.0.0",
  "description": "Adora & Alora — curated lifestyle house. Full-stack enterprise website.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"node --watch app.js\" \"node node_modules/vite/bin/vite.js --port 5175\"",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ics": "^3.8.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.4",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^8.2.0"
  },
  "overrides": {
