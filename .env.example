# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aora-house?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=rokitonline.com
SMTP_PORT=465
SMTP_USER=mailfix@rokitonline.com
SMTP_PASS=your_email_password
SMTP_SECURE=true
FROM_EMAIL="Aora House" <mailfix@rokitonline.com>

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=replace_with_your_webhook_secret

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5175
CLIENT_URL=http://localhost:5175

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE_MB=10

# ─── Dev Email ────────────────────────────────────────────────────────────────
DEV_NOTIFICATION=aceddivisionllc@gmail.com
